# Application
APP_NAME=Atlas AI
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas

